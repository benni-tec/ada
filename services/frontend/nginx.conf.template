# Serves the built single-page app. Requests reach it through the gateway.
# A template: nginx fills in ${PORT} at startup (default in the Dockerfile).
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Vite puts a content hash in every asset name, so they never change.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Unknown paths are client-side routes.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
